#!/usr/bin/env bash
# .githooks/pre-commit — tripwire, not the gate.
#
# Runs on STAGED changes only:
#   1. bash -n on staged .sh (hard); shellcheck on staged .sh — hard
#      when shellcheck is installed, skipped when absent (AGENTS.md "Code
#      quality": these are pre-commit checks, not optional)
#   2. ruff format --check + ruff check on staged .py — hard when ruff is
#      installed, skipped when absent
#   3. trailing whitespace / CRLF / staged files > 50 MB (all staged
#      files; text-only checks for text files)
#   4. secret scan of the staged diff (same heuristic as scripts/gate.sh;
#      unconditional — runs even on delete-only commits)
#   5. full ./scripts/gate.sh
#
# Presence = the only axis of softness: a linter that is not installed is
# skipped (its baseline is "not installed" per the gate baseline note), a
# linter that IS installed blocks on failure (FAIL=1). This is what makes
# the hook a real tripwire rather than a no-op once the tooling lands.
#
# git commit --no-verify stays allowed with a one-line reason in the PR
# body (AGENTS.md "Code quality"). The G2 gate (gate.sh) is still the
# formal check; this hook is the early warning.

set -uo pipefail

# Run the hook from the repo root no matter where git invoked it
# (git commit -C, manual sh .githooks/pre-commit — G3c round 6 P2).
cd "$(git rev-parse --show-toplevel)"

FAIL=0
# PID-unique temp files so concurrent git operations on one host
# (rebase + commit) cannot interleave on shared /tmp names; cleaned up
# on exit (G3c round 4 P1).
TMP_PREFIX="/tmp/precommit-$$"
trap 'rm -f "${TMP_PREFIX}"_*' EXIT

# Collect staged files (added/copied/modified/renamed; ignore deletions).
# ACMR: R = rename-with-edit — a renamed .sh/.py must not escape the
# checks below (G3c round 5 P2).
STAGED="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -n "$STAGED" ]; then
  # 1) bash -n (hard) + shellcheck (hard when installed) on staged .sh
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    if ! bash -n "$f" 2>"${TMP_PREFIX}_bashn"; then
      echo "pre-commit FAIL: bash -n $f" >&2
      cat "${TMP_PREFIX}_bashn" >&2
      FAIL=1
      # Syntax is already broken: skip the rest of this file's checks
      # (shellcheck on a broken file just adds noise — G3c round 4 P2).
      continue
    fi
    if command -v shellcheck >/dev/null 2>&1; then
      if ! shellcheck "$f" >"${TMP_PREFIX}_shellcheck" 2>&1; then
        echo "pre-commit FAIL: shellcheck $f (installed, so hard):" >&2
        sed 's/^/    /' "${TMP_PREFIX}_shellcheck" >&2
        FAIL=1
      fi
    fi
  done < <(echo "$STAGED" | grep -E '\.sh$' || true)

  # 2) ruff format --check + ruff check (hard when installed) on staged .py
  if command -v ruff >/dev/null 2>&1; then
    PYFILES=()
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      PYFILES+=("$f")
    done < <(echo "$STAGED" | grep -E '\.py$' || true)
    if [ "${#PYFILES[@]}" -gt 0 ]; then
      if ! ruff format --check "${PYFILES[@]}" >"${TMP_PREFIX}_rufffmt" 2>&1; then
        echo "pre-commit FAIL: ruff format --check (installed, so hard):" >&2
        sed 's/^/    /' "${TMP_PREFIX}_rufffmt" >&2
        FAIL=1
      fi
      if ! ruff check "${PYFILES[@]}" >"${TMP_PREFIX}_ruff" 2>&1; then
        echo "pre-commit FAIL: ruff check (installed, so hard):" >&2
        sed 's/^/    /' "${TMP_PREFIX}_ruff" >&2
        FAIL=1
      fi
    fi
  fi

  # 3) trailing whitespace / CRLF / no staged file > 50 MB
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    # 50 MB staged-file cap: applies to ALL staged files, including
    # binaries (a 5 GB .gguf staged by a later phase must not sneak
    # past silently — G3c round 6 P1).
    size="$(stat -c%s "$f" 2>/dev/null || stat -f%z "$f" 2>/dev/null)"
    if [ -n "$size" ] && [ "$size" -gt 52428800 ]; then
      echo "pre-commit FAIL: $f is $((size / 1048576)) MB (> 50 MB staged-file cap)" >&2
      FAIL=1
    fi
    # Text-file checks below: binary skip = extension whitelist OR a NUL
    # byte in the first 64 KB (catches PDFs/fonts/wasm/... without a
    # growing extension list).
    case "$f" in
      *.png|*.jpg|*.jpeg|*.gif|*.woff2|*.gguf) continue ;;
    esac
    if head -c 65536 "$f" | LC_ALL=C grep -q $'\0'; then
      continue
    fi
    if grep -qE ' +$' "$f"; then
      echo "pre-commit FAIL: trailing whitespace in $f" >&2
      grep -nE ' +$' "$f" | head -5 | sed 's/^/    /' >&2
      FAIL=1
    fi
    if grep -q $'\r' "$f"; then
      echo "pre-commit FAIL: CRLF line endings in $f" >&2
      FAIL=1
    fi
  done < <(echo "$STAGED")
fi

# 4) secret scan of the staged diff (same logic as gate.sh). Heuristic,
#    not a scanner: a 16+ char quoted literal after a key= / key: pair is
#    flagged. Runs UNCONDITIONALLY — even on a delete-only commit the
#    full cached diff is scanned, so deleting a file that carries a
#    secret still blocks (G3c round 6 P1). Placeholders like
#    "<pinned-sha-at-install>" do NOT match (the value inside the quotes
#    must be bare [A-Za-z0-9]{16,}); ${...} and multi-word values
#    likewise. Known FP class: real-but-local identifiers — the
#    --no-verify escape hatch is the documented path for those.
if git diff --cached | grep -E '^\+' | grep -vE '^\+\+\+' \
   | grep -Eiq '(api[_-]?key|secret|password|token|bearer)\s*[:=]\s*["'\''][A-Za-z0-9]{16,}'; then
  echo "pre-commit FAIL: possible secret literal in staged diff:" >&2
  git diff --cached | grep -E '^\+' | grep -vE '^\+\+\+' \
    | grep -Ei '(api[_-]?key|secret|password|token|bearer)\s*[:=]\s*["'\''][A-Za-z0-9]{16,}' \
    | sed 's/^/    /' >&2
  FAIL=1
fi

# 5) full local gate (its own exit code is authoritative for the diff)
if ! bash ./scripts/gate.sh; then
  echo "pre-commit: gate.sh failed (details above)" >&2
  FAIL=1
fi

if [ $FAIL -ne 0 ]; then
  echo "pre-commit: BLOCKED (fix and re-stage, or --no-verify with a one-line PR-body reason)" >&2
  exit 1
fi
echo "pre-commit: ok"
