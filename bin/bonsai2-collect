#!/usr/bin/env python3
"""bonsai2-collect — read one subagent task's result (S3.2; MAP 3.6).

Thin deploy file; the flow lives in `bonsai2_harness.py`
(`cmd_collect`).

Usage (the S3.2 surface, locked):
  bonsai2-collect <TASK_ID>

Exit codes (S3.2 closed set, per-command mapping):
  20 = the task is `done` — stdout JSON = the task JSON +
       `{"answer": ..., "reasoning": ..., "usage": {...}}`
  21 = the task is `failed`
  22 = the task is `timeout` (its own --deadline expired mid-run, S3.4)
  0  = non-terminal (`queued`/`running`/`engine_retried`) — the
       current-state JSON is returned; the caller polls
  2  = TASK_ID unknown / malformed args / bad config

The command never touches the engine — the task record + the result
file are the source of truth (S3.1), so collect works on a dead stack.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import bonsai2_harness as H  # noqa: E402

if __name__ == "__main__":
    sys.exit(H.dispatch("bonsai2-collect", sys.argv[1:]))
