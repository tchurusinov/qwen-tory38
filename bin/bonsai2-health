#!/usr/bin/env python3
"""bonsai2-health — the RAW /run/bonsai2/health.json, pretty-printed
(S3.2).

Thin deploy file (MAP 3.2; shared logic in `bonsai2_harness.py`).
Dumps the manager's document as-is (its `stack` / `instances` /
`main_endpoint` / `main_healthy` / `main_only_reason` fields, S3.1
schema) — no re-probing: the point is to see exactly what the manager
last wrote (diagnose the manager, not the pool). The live main-endpoint
probe is `bonsai2-status`'s job.

Exit codes (S3.2 closed set): 0 = ok, 84 = health.json absent/invalid
(manager down). No 82: no probe on this command.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import bonsai2_harness as H  # noqa: E402

if __name__ == "__main__":
    sys.exit(H.dispatch("bonsai2-health", sys.argv[1:]))
