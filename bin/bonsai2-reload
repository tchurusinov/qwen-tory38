#!/usr/bin/env python3
"""bonsai2-reload — re-spawn unloaded instances through the manager
(S3.2; MAP 3.8).

Thin deploy file; the flow lives in `bonsai2_harness.py`
(`cmd_reload`).

Usage (the S3.2 surface, locked):
  bonsai2-reload [--all | --instances i[,i,...]]

Manager-mediated (S3.2): the command writes one request into the
manager's control/ queue; the manager re-spawns the targeted indexes
through the normal path (S1.4 allocation tier, S2.2 unit start, S2.2
health re-probe) and acks the request. A tier failure at a target
index leaves it `bunloaded` (the others proceed); stdout JSON carries
`{"reloaded": [i...], "state": "ok" | "partial"}` — a partial reload
is a valid state (exit 0, the WARN_VRAM_SHORTFALL detail is in the
payload).

Exit codes (S3.2 closed set, per-command mapping):
  0  = operation done (including a partial reload)
  2  = malformed args (unknown instance index, both selectors given)
  84 = manager down (no ack within the wait budget)
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import bonsai2_harness as H  # noqa: E402

if __name__ == "__main__":
    sys.exit(H.dispatch("bonsai2-reload", sys.argv[1:]))
