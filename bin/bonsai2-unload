#!/usr/bin/env python3
"""bonsai2-unload — stop subagent instances through the manager
(S3.2; MAP 3.8).

Thin deploy file; the flow lives in `bonsai2_harness.py`
(`cmd_unload`).

Usage (the S3.2 surface, locked):
  bonsai2-unload [--all | --instances i[,i,...]]

Manager-mediated (S3.2): the command writes one request into the
manager's control/ queue; the manager SIGTERMs the targeted
bonsai2-server@i units (instant VRAM release), marks the indexes
`bunloaded` in health.json, and acks the request. With zero running
instances the stack enters main-only mode
(`main_only_reason: "user_unloaded"`, S2.4). Idempotent: an
already-unloaded (or not-running) index is a no-op for that index.
stdout JSON carries `{"unloaded": [i...]}`.

Exit codes (S3.2 closed set, per-command mapping):
  0  = operation done (including the no-op case)
  2  = malformed args (unknown instance index, both selectors given)
  84 = manager down (no ack within the wait budget)
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import bonsai2_harness as H  # noqa: E402

if __name__ == "__main__":
    sys.exit(H.dispatch("bonsai2-unload", sys.argv[1:]))
